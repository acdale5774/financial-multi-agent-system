# Local infrastructure configuration for Docker Compose.
# Copy to `.env` (docker compose reads it automatically). Do NOT commit `.env`.

# Postgres credentials and database name. These must line up with the
# DATABASE_URL used by the backend (see ../be/.env.example):
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
POSTGRES_USER=finapp
POSTGRES_PASSWORD=finapp
POSTGRES_DB=financial

# Host port to expose Postgres on (change if 5432 is already in use locally).
POSTGRES_PORT=5432
