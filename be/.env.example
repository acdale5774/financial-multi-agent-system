# Backend environment configuration.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# --- Database -------------------------------------------------------------
# Postgres connection string. Must point at a database with pgvector enabled
# (the local Docker Compose instance in ../infra provides this).
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://finapp:finapp@localhost:5432/financial

# --- External data sources ------------------------------------------------
# SimFin API key for structured financial data ingestion. Required.
# The legacy "free" key now returns HTTP 401 on bulk downloads — get a key at
# https://app.simfin.com/ (free account) and paste it here.
SIMFIN_API_KEY=
# Local cache directory for downloaded SimFin bulk datasets.
SIMFIN_DATA_DIR=./_simfin_cache
# Default SimFin market to ingest.
SIMFIN_MARKET=us

# --- Documents / embeddings ------------------------------------------------
# Folder holding the case-study corpus (SEC filings HTML + transcripts JSON).
DOCUMENTS_DATA_DIR=../case_study_data
# Embedding provider: openai (default; uses OPENAI_API_KEY below, network call
# at ingestion and query time) or model2vec (local/offline fallback, weaker
# retrieval — the measured comparison is in be/evals/retrieval_report*.md).
# Changing provider/model means updating the dimension AND the vector(N)
# column in db/schema.sql (re-apply it), then: python -m ingestion.reembed
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# model2vec fallback values:
#EMBEDDING_PROVIDER=model2vec
#EMBEDDING_MODEL=minishlab/potion-retrieval-32M
#EMBEDDING_DIMENSION=512

# --- Document retrieval ------------------------------------------------------
# Strategy for search_documents: dense | lexical | hybrid. The default is
# picked from the labeled benchmark (`python -m evals.retrieval`); see
# be/evals/retrieval_report.md before changing it.
RETRIEVAL_STRATEGY=hybrid
# Hybrid tuning: per-leg candidate depth fed into RRF, and the RRF constant.
RETRIEVAL_LEG_K=30
RETRIEVAL_RRF_K=60

# --- LLM provider (agent layer) ---------------------------------------------
# OpenAI API key for the query agent (tool-calling loop). If left empty, the
# SDK's own credential resolution is used (OPENAI_API_KEY env var).
OPENAI_API_KEY=
# OpenAI model driving the agent loop.
AGENT_MODEL=gpt-5.5

# --- Application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
