# Backend environment configuration.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# --- Database -------------------------------------------------------------
# Postgres connection string. Must point at a database with pgvector enabled
# (the local Docker Compose instance in ../infra provides this).
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://finapp:finapp@localhost:5432/financial

# --- External data sources ------------------------------------------------
# SimFin API key for structured financial data ingestion. Required.
# The legacy "free" key now returns HTTP 401 on bulk downloads — get a key at
# https://app.simfin.com/ (free account) and paste it here.
SIMFIN_API_KEY=
# Local cache directory for downloaded SimFin bulk datasets.
SIMFIN_DATA_DIR=./_simfin_cache
# Default SimFin market to ingest.
SIMFIN_MARKET=us

# --- Embeddings / LLM provider --------------------------------------------
# TODO: Choose a provider and set the matching key(s). The embedding model's
#       vector dimension MUST match `document_chunks.embedding` in db/schema.sql.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_MODEL=
# LLM_MODEL=

# --- Application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
